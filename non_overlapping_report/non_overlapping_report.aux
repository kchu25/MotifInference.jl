\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Experiment 1 --- do filters land on different positions?}{4}{subsection.4.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Do different filters fire at different positions? Inference layer $L^\star =1$, window $p=3$, $S=45$; 2972 sequences, 40 epochs. A filter counts as active where its magnitude exceeds the 0.9 percentile (the same threshold motif finding uses). \emph  {Occupancy} = mean active filters per occupied position (1.0 = perfectly separated); \emph  {null} = chance level under a per-filter position shuffle; \emph  {exclusivity} = fraction of positions used by exactly one filter. $\mathrm  {NonOverlap}$ is the scale-free cosine overlap \eqref  {eq:norm}.}}{4}{table.1}\protected@file@percent }
\newlabel{tab:exp1}{{1}{4}{Do different filters fire at different positions? Inference layer $L^\star =1$, window $p=3$, $S=45$; 2972 sequences, 40 epochs. A filter counts as active where its magnitude exceeds the 0.9 percentile (the same threshold motif finding uses). \emph {Occupancy} = mean active filters per occupied position (1.0 = perfectly separated); \emph {null} = chance level under a per-filter position shuffle; \emph {exclusivity} = fraction of positions used by exactly one filter. $\NonOv $ is the scale-free cosine overlap \eqref {eq:norm}}{table.1}{}}
